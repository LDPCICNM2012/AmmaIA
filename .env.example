# ─────────────────────────────────────────────────────────────
# AmmaIA - Variables de Entorno y Configuración (Plantilla)
# ─────────────────────────────────────────────────────────────
# Copia este archivo como '.env' e introduce tus credenciales reales:
# cp .env.example .env

# Clave API de Google Gemini (Obtén la tuya en https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Clave secreta para generación de sesiones seguras JWT (HS256)
JWT_SECRET=your_jwt_secret_key_here

# Configuración del Motor de IA y Servidor
DEFAULT_MODEL=gemini-2.5-flash
HOST=127.0.0.1
PORT=8000

# Base de Datos Cloud Supabase (Opcional para persistencia permanente en Render)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
